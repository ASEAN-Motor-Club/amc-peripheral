        { label: "What is not changing", href: "#unchanged" },
        { label: "The exchange", href: "#pool" },
        { label: "How the migration will proceed", href: "#migration" },
        { label: "Governance of the reform", href: "#governance" },
        { label: "Dates and further information", href: "#dates" },
      ]} />
    </div>
  </div>
</main>

</GovLayout>
