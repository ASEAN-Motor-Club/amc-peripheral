      <details>
        <summary>Accounting treatment</summary>
        <div>
          <h3>Wealth Tax Entry</h3>
          <table class="govuk-table">
            <thead><tr><th>Account</th><th>Debit</th><th>Credit</th></tr></thead>
            <tbody>
              <tr><td>Player Checking (Liability, Bank)</td><td>tax_amount</td><td>—</td></tr>
