{pkgs, ...}: let
  # Motor Town vehicle 3D viewer — plain static HTML + three.js (CDN) + the
  # extraction/rebake toolchain. No build step.
  #
  # Only the viewer SHELL is packaged here. The per-vehicle assets (manifests,
  # GLBs, textures, materials.json — 1-6 MB each, versioned to the game PAK)
  # are generated by tools/stage_all.sh and live in /var/lib/mt-viewer on the
  # host; nginx serves that directory and index.html is symlinked into it.
  package = pkgs.stdenv.mkDerivation {
    pname = "mt-viewer";
    version = "0.2.0";
    src = ./.;
    dontBuild = true;
    installPhase = ''
      runHook preInstall
      mkdir -p $out
      cp index.html $out/
      cp README.md $out/
      mkdir -p $out/tools
      cp -r tools/. $out/tools/
      runHook postInstall
    '';
  };
in {
  inherit package;
}
